<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Icon -->
    <ImageView
        android:id="@+id/ras_dialog_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_info_outline"
        android:tint="?android:attr/colorAccent" />

    <!-- Title -->
    <TextView
        android:id="@+id/ras_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/ras_lost_dialog_title"
        android:textSize="24sp"
        android:lineHeight="32sp"
        android:textColor="?android:attr/textColorPrimary"
        android:fontFamily="sans-serif"
        android:gravity="center" />

    <!-- Main Description Message -->
    <TextView
        android:id="@+id/ras_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/ras_lost_dialog_message"
        android:textSize="14sp"
        android:lineHeight="20sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="start" />

    <!-- Section Header: Keep in mind -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/ras_dialog_keep_in_mind_header"
        android:textSize="14sp"
        android:lineHeight="20sp"
        android:textColor="?android:attr/colorAccent"
        android:fontFamily="sans-serif"
        android:textFontWeight="800" />

    <!-- List Item 1: Permission Detail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_apps"
            android:tint="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/ras_dialog_settings_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ras_lost_detail_permission"
            android:textSize="14sp"
            android:lineHeight="20sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Bottom Action Button (Right-aligned) -->
    <Button
        android:id="@+id/ras_dialog_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/ras_dialog_button_close"
        android:background="@drawable/ras_dialog_button_outline"
        android:textColor="?android:attr/colorAccent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:minHeight="40dp" />

</LinearLayout>
